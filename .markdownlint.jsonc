{
  // Repository Markdown rules, read by Rove Sentinel's deterministic
  // markdownlint lane (changed lines only). House-style rules are off so the
  // same hit is not deferred PR after PR.
  "default": true,
  // Prose wraps at about 80 columns by convention; tables and links
  // legitimately run longer.
  "MD013": false,
  // List marker, ordered-list prefix and emphasis styles are house style.
  "MD004": false,
  "MD029": false,
  "MD036": false,
  "MD049": false,
  // Documents repeat section titles under different parents.
  "MD024": { "siblings_only": true },
  // Table column style is cosmetic.
  "MD060": false
}
